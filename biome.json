{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"files": { "includes": ["webapp/src/**"] },
	"css": {
		"linter": {
			"enabled": false
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": { "useTemplate": "off" },
			"suspicious": { "noExplicitAny": "off", "noArrayIndexKey": "off" },
			"correctness": { "useExhaustiveDependencies": "off", "useParseIntRadix": "off" },
			"complexity": { "noUselessFragments": "off" },
			"a11y": {
				"useButtonType": "off",
				"noLabelWithoutControl": "off",
				"noStaticElementInteractions": "off",
				"useKeyWithClickEvents": "off",
				"useMediaCaption": "off"
			}
		}
	},
	"formatter": { "enabled": true, "lineWidth": 120 }
}
