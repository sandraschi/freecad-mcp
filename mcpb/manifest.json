{
  "manifest_version": "0.2",
  "name": "freecad-mcp",
  "version": "0.6.0",
  "description": "FreeCAD 3D CAD automation: headless documents and export, plus CFD via FluidX3D/OpenFOAM",
  "author": { "name": "sandraschi" },
  "server": {
    "type": "python",
    "entry_point": "run_server.py",
    "mcp_config": {
      "command": "uv",
      "args": ["run","--directory","${PWD}","run_server.py"],
      "env": {
        "PYTHONPATH": "${PWD}/src",
        "PYTHONUNBUFFERED": "1"
      }
    }
  },
  "tools": [
    { "name": "freecad_status", "description": "freecad_status" },
    { "name": "step_to_stl", "description": "step_to_stl" },
    { "name": "model_info", "description": "model_info" },
    { "name": "create_shape", "description": "create_shape" },
    { "name": "slicer_status", "description": "slicer_status" },
    { "name": "slice_stl", "description": "slice_stl" },
    { "name": "freecad_gui", "description": "freecad_gui" },
    { "name": "freecad_design_loop", "description": "freecad_design_loop" },
    { "name": "marketplace_search", "description": "marketplace_search" },
    { "name": "marketplace_download", "description": "marketplace_download" },
    { "name": "marketplace_categories", "description": "marketplace_categories" },
    { "name": "show_marketplace_card", "description": "show_marketplace_card" },
    { "name": "list_skills", "description": "List available skill names." },
    { "name": "get_skill", "description": "Return the raw SKILL.md content for a skill." },
    { "name": "get_status", "description": "FreeCAD MCP server status." },
    { "name": "health_check", "description": "Return server health: FreeCAD status, Docker, uptime." },
    { "name": "upload_file", "description": "Upload a STEP/STL file for processing." },
    { "name": "download_file", "description": "Download a processed STL, G-code, IFC, or FCStd file." },
    { "name": "serve_case_file", "description": "Serve a file from a FluidX3D case directory." },
    { "name": "list_files", "description": "List uploaded and output files including G-code, IFC, and FCStd." },
    { "name": "depot_list", "description": "depot_list" },
    { "name": "depot_get", "description": "depot_get" },
    { "name": "depot_rename", "description": "depot_rename" },
    { "name": "depot_delete", "description": "depot_delete" },
    { "name": "depot_create", "description": "depot_create" },
    { "name": "depot_upload", "description": "depot_upload" },
    { "name": "execute_tool", "description": "Execute an MCP tool via REST (for webapp convenience)." },
    { "name": "stream_logs", "description": "SSE log stream." },
    { "name": "categories_endpoint", "description": "List categories for a marketplace source." },
    { "name": "search_endpoint", "description": "Search a marketplace for CAD models." },
    { "name": "download_endpoint", "description": "Download a model from a marketplace URL into the uploads directory." },
    { "name": "diagnostics", "description": "Return server diagnostics for CUA smoke test." },
    { "name": "capabilities", "description": "List server capabilities." },
    { "name": "shutdown", "description": "Gracefully shut down the server." },
    { "name": "llm_discover", "description": "Discover local LLM providers (Ollama, LM Studio, vLLM).      Returns detected providers and avail..." },
    { "name": "get_settings", "description": "Get LLM and marketplace settings." },
    { "name": "update_settings", "description": "Update LLM or marketplace settings." },
    { "name": "chat_completion", "description": "Chat with CAD expert via Ollama." },
    { "name": "bim_create_wall", "description": "bim_create_wall" },
    { "name": "bim_create_slab", "description": "bim_create_slab" },
    { "name": "bim_create_column", "description": "bim_create_column" },
    { "name": "bim_create_window", "description": "bim_create_window" },
    { "name": "bim_create_door", "description": "bim_create_door" },
    { "name": "bim_create_roof", "description": "bim_create_roof" },
    { "name": "bim_export_ifc", "description": "bim_export_ifc" },
    { "name": "bim_import_ifc", "description": "bim_import_ifc" },
    { "name": "mesh_to_solid", "description": "mesh_to_solid" },
    { "name": "bim_status", "description": "bim_status" },
    { "name": "freecad_bridge", "description": "freecad_bridge" },
    { "name": "cfd_status", "description": "cfd_status" },
    { "name": "cfd_create_domain", "description": "cfd_create_domain" },
    { "name": "cfd_configure_physics", "description": "cfd_configure_physics" },
    { "name": "cfd_set_boundary", "description": "cfd_set_boundary" },
    { "name": "cfd_build_case", "description": "cfd_build_case" },
    { "name": "cfd_run_solver", "description": "cfd_run_solver" },
    { "name": "cfd_read_results", "description": "cfd_read_results" },
    { "name": "cfd_parametric_study", "description": "cfd_parametric_study" },
    { "name": "cfd_nl2foam", "description": "cfd_nl2foam" },
    { "name": "cfd_sample_for_pinns", "description": "cfd_sample_for_pinns" },
    { "name": "cfd_snappy_mesh", "description": "cfd_snappy_mesh" },
    { "name": "cfd_post_process", "description": "cfd_post_process" },
    { "name": "cfd_map_loads_to_fem", "description": "cfd_map_loads_to_fem" },
    { "name": "cad_depot", "description": "cad_depot" },
    { "name": "cad_create", "description": "cad_create" },
    { "name": "fem_status", "description": "fem_status" },
    { "name": "fem_create_analysis", "description": "fem_create_analysis" },
    { "name": "fem_set_material", "description": "fem_set_material" },
    { "name": "fem_set_constraint", "description": "fem_set_constraint" },
    { "name": "fem_mesh", "description": "fem_mesh" },
    { "name": "fem_run", "description": "fem_run" },
    { "name": "fem_read_results", "description": "fem_read_results" },
    { "name": "run_fem_analysis", "description": "run_fem_analysis" },
    { "name": "cfd_fluidx3d_status", "description": "cfd_fluidx3d_status" },
    { "name": "cfd_fluidx3d_prebuilt", "description": "cfd_fluidx3d_prebuilt" },
    { "name": "cfd_fluidx3d_setup", "description": "cfd_fluidx3d_setup" },
    { "name": "cfd_fluidx3d_compile", "description": "cfd_fluidx3d_compile" },
    { "name": "cfd_fluidx3d_run", "description": "cfd_fluidx3d_run" },
    { "name": "cfd_fluidx3d_results", "description": "cfd_fluidx3d_results" },
    { "name": "cfd_fluidx3d_explain", "description": "cfd_fluidx3d_explain" },
    { "name": "cfd_fluidx3d_export_for_render", "description": "cfd_fluidx3d_export_for_render" },
    { "name": "cfd_fluidx3d_render", "description": "cfd_fluidx3d_render" },
    { "name": "cfd_fluidx3d_parametric_sweep", "description": "cfd_fluidx3d_parametric_sweep" },
    { "name": "cfd_fluidx3d_train_surrogate", "description": "cfd_fluidx3d_train_surrogate" },
    { "name": "cfd_surrogate_predict", "description": "cfd_surrogate_predict" },
    { "name": "freecad_model", "description": "freecad_model" }
  ]
}
