# FreeCAD MCP — Environment Configuration
# Copy to .env and fill in your values.

# FreeCAD installation path
FREECAD_PATH=C:\Program Files\FreeCAD\bin\FreeCAD.exe

# PrusaSlicer path (optional, for slicing)
PRUSA_SLICER_PATH=

# MCP transport mode (stdio | http | dual)
MCP_TRANSPORT=dual

# Server host and port
MCP_HOST=127.0.0.1
MCP_PORT=10944

# Ollama LLM endpoint (optional, for chat)
OLLAMA_URL=http://127.0.0.1:11434

# Marketplace API keys (optional)
THINGIVERSE_API_KEY=
GRABCAD_API_KEY=

# FluidX3D path (optional, for GPU CFD)
FLUIDX3D_PATH=

# Working directory for temp files (optional)
FREECAD_MCP_WORK_DIR=
